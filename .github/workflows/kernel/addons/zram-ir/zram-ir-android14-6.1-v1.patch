--- a/drivers/block/zram/Kconfig
+++ b/drivers/block/zram/Kconfig
@@ -78,3 +78,37 @@ config ZRAM_MEMORY_TRACKING
 	  /sys/kernel/debug/zram/zramX/block_state.
 
 	  See Documentation/admin-guide/blockdev/zram.rst for more information.
+
+config ZRAM_MULTI_COMP
+	bool "Enable multiple compression streams"
+	depends on ZRAM
+	help
+	  This enables multiple compression backends per zram device
+	  (primary + up to 3 secondary algorithms, set via
+	  /sys/block/zramX/{comp_algorithm,recomp_algorithm}), which the
+	  ZRAM-IR addon uses to immediately try a slower/better compressor
+	  on pages the primary one can't shrink enough. This is a partial,
+	  ABI-safe backport (no vendor-frozen struct involved: ZRAM is
+	  built as part of this kernel, not a separately-compiled vendor
+	  module): the idle-time background recompression sysfs trigger
+	  from upstream (/sys/block/zramX/recompress) is intentionally not
+	  included, since ZRAM-IR does not need it.
+
+choice
+	prompt "Default zram secondary (recomp) compressor"
+	default ZRAM_DEF_RECOMP_NONE
+	depends on ZRAM_MULTI_COMP
+
+config ZRAM_DEF_RECOMP_NONE
+	bool "none (configure recomp_algorithm from userspace only)"
+
+config ZRAM_DEF_RECOMP_ZSTD
+	bool "zstd"
+	depends on CRYPTO_ZSTD
+
+endchoice
+
+config ZRAM_DEF_RECOMP
+	string
+	default "zstd" if ZRAM_DEF_RECOMP_ZSTD
+	default ""
